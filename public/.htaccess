<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Passa o header Authorization para o PHP
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

    # Rotas da API vão para o Laravel
    RewriteCond %{REQUEST_URI} ^/api/
    RewriteRule ^ index.php [L]

    # Arquivos e diretórios reais são servidos diretamente (JS, CSS, imagens)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rotas da SPA de Solicitação de Transporte (basename "/solicitar")
    # retornam solicitacao.html
    RewriteCond %{REQUEST_URI} ^/solicitar
    RewriteRule ^ /solicitacao.html [L]

    # Demais rotas do frontend React retornam o index.html da SPA principal
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteRule ^ /index.html [L]
</IfModule>
